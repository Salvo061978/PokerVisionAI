<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1420">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="310dp" android:layout_height="match_parent" android:layout_gravity="right" android:orientation="vertical" android:padding="14dp" android:background="#F0111B29">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POKER VISION 0.2" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Avvio fotocamera..." android:textColor="#88DFBE" android:textSize="14sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="PIATTO" android:textColor="#A8BBD1" android:textSize="12sp"/>
        <TextView android:id="@+id/pot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="CHIAMATA VISIBILE" android:textColor="#A8BBD1" android:textSize="12sp"/>
        <TextView android:id="@+id/call" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="AZIONE LETTA" android:textColor="#A8BBD1" android:textSize="12sp"/>
        <TextView android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="21sp"/>
        <TextView android:id="@+id/phase" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Carte: riconoscimento non disponibile" android:textColor="#FFCF80" android:textSize="13sp"/>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pausa lettura"/>
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salva rilevazione"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Analisi delle mani dopo la partita. Dati OCR sperimentali da verificare." android:textColor="#AEC0D0" android:textSize="11sp"/>
        <TextView android:id="@+id/ocr" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>